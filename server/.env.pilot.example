# Copy to .env.pilot; keep that private file out of version control.
MEM0_PILOT_API_KEY=
MEM0_PILOT_JWT_SECRET=
MEM0_PILOT_POSTGRES_PASSWORD=
OMLX_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Absolute host path to the pre-populated local FastEmbed model cache directory.
MEM0_PILOT_FASTEMBED_CACHE=

# Optional: set only to the exact locally installed pilot dependency image.
# MEM0_PILOT_IMAGE=fixture-cpu-build-only-mem0@sha256:53c6ae836fc6b45bc80779a034082ab23fe728832735f27a614dd7e7f842ffab
